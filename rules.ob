// OrignaBase security rules for the origna_gta data model.
//
// Notes:
// - OrignaBase currently uses `rules <collection> { ... }`, not `collection "name" { ... }`.
// - Firestore subcollections are represented here as standalone collections: `cart`,
//   `users__cart`,
//   `warehouses`, `review_votes`, `chat_conversations`, and `chat_messages`.
// - The current DSL cannot express Firestore-style cross-document lookups or array-contains
//   checks, so seller/order rules rely on denormalized per-document fields where available.

rules users {
    read: isAuthenticated() && (isOwner(resource.uid) || hasRole("admin"));
    create: isAuthenticated() && fieldEqualsAuth("uid");
    update: isAuthenticated() && (hasRole("admin") || (isOwner(resource.uid) && fieldUnchanged("uid")));
    delete: false;
    list: hasRole("admin");
}

rules products {
    read: true;
    create: isAuthenticated() && ((hasRole("seller") && fieldEqualsAuth("sellerId")) || hasRole("admin"));
    update: isAuthenticated() && (hasRole("admin") || (hasRole("seller") && isOwner(resource.sellerId) && fieldUnchanged("sellerId")));
    delete: isAuthenticated() && (hasRole("admin") || (hasRole("seller") && isOwner(resource.sellerId)));
    list: true;
}

rules orders {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.userId) ||
        isOwner(resource.buyerId) ||
        isOwner(resource.sellerId) ||
        isOwner(resource.seller_id)
    );
    create: hasRole("admin") || (
        isAuthenticated() &&
        (fieldEqualsAuth("userId") || fieldEqualsAuth("buyerId")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("buyerId")
    );
    update: hasRole("admin");
    delete: false;
    list: isAuthenticated();
}

rules product_ratings {
    read: isAuthenticated();
    create: false;
    update: hasRole("admin") || isOwner(resource.sellerId) || isOwner(resource.seller_id);
    delete: hasRole("admin");
    list: isAuthenticated();
}

rules cart {
    read: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    create: isAuthenticated() && (
        (fieldEqualsAuth("userId") ||
            fieldEqualsAuth("ownerId") ||
            fieldEqualsAuth("uid")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("ownerId") &&
        fieldAbsentOrEqualsAuth("uid")
    );
    update: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    ) && fieldUnchanged("userId") && fieldUnchanged("ownerId") && fieldUnchanged("uid");
    delete: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    list: isAuthenticated();
}

rules users__cart {
    read: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    create: isAuthenticated() && (
        (fieldEqualsAuth("userId") ||
            fieldEqualsAuth("ownerId") ||
            fieldEqualsAuth("uid")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("ownerId") &&
        fieldAbsentOrEqualsAuth("uid")
    );
    update: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    ) && fieldUnchanged("userId") && fieldUnchanged("ownerId") && fieldUnchanged("uid");
    delete: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    list: isAuthenticated();
}

rules warehouses {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.sellerId) ||
        isOwner(resource.uid)
    );
    create: false;
    update: false;
    delete: false;
    list: isAuthenticated() && (hasRole("seller") || hasRole("admin"));
}

rules remote_config {
    read: true;
    create: isAuthenticated() && hasRole("admin");
    update: hasRole("admin");
    delete: hasRole("admin");
    list: true;
}

rules config {
    read: hasRole("admin");
    create: false;
    update: false;
    delete: false;
    list: hasRole("admin");
}

rules admin_logs {
    read: hasRole("admin");
    create: false;
    update: false;
    delete: false;
    list: hasRole("admin");
}

rules security_alerts {
    read: hasRole("admin");
    create: false;
    update: false;
    delete: false;
    list: hasRole("admin");
}

rules error_events {
    read: isAuthenticated() && (hasRole("admin") || isOwner(resource.userId));
    create: isAuthenticated() && fieldEqualsAuth("userId");
    update: hasRole("admin");
    delete: false;
    list: hasRole("admin");
}

rules rate_limits {
    read: hasRole("admin");
    create: false;
    update: false;
    delete: false;
    list: hasRole("admin");
}

rules webhook_logs {
    read: hasRole("admin");
    create: false;
    update: false;
    delete: false;
    list: hasRole("admin");
}

rules webhook_events {
    read: hasRole("admin");
    create: false;
    update: false;
    delete: false;
    list: hasRole("admin");
}

rules return_requests {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.buyerId) ||
        isOwner(resource.userId) ||
        isOwner(resource.sellerId)
    );
    create: false;
    update: hasRole("admin");
    delete: false;
    list: isAuthenticated();
}

rules coupons {
    read: hasRole("admin");
    create: false;
    update: false;
    delete: false;
    list: hasRole("admin");
}

rules seller_ratings {
    read: isAuthenticated();
    create: false;
    update: false;
    delete: false;
    list: isAuthenticated();
}

rules review_votes {
    read: isAuthenticated();
    create: false;
    update: false;
    delete: false;
    list: isAuthenticated();
}

rules stock_notifications {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    create: false;
    update: false;
    delete: false;
    list: isAuthenticated();
}

rules subscriptions {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.userId) ||
        isOwner(resource.uid) ||
        isOwner(resource.ownerId)
    );
    create: hasRole("admin");
    update: hasRole("admin");
    delete: hasRole("admin");
    list: hasRole("admin");
}

rules chat_conversations {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.buyerId) ||
        isOwner(resource.sellerId)
    );
    create: isAuthenticated() && (
        fieldEqualsAuth("buyerId") ||
        (hasRole("seller") && fieldEqualsAuth("sellerId"))
    );
    update: isAuthenticated() && (
        hasRole("admin") ||
        ((isOwner(resource.buyerId) || isOwner(resource.sellerId)) &&
            fieldUnchanged("buyerId") &&
            fieldUnchanged("sellerId"))
    );
    delete: false;
    list: isAuthenticated();
}

rules chats {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.buyerId) ||
        isOwner(resource.sellerId)
    );
    create: isAuthenticated() && (
        fieldEqualsAuth("buyerId") ||
        (hasRole("seller") && fieldEqualsAuth("sellerId"))
    );
    update: isAuthenticated() && (
        hasRole("admin") ||
        ((isOwner(resource.buyerId) || isOwner(resource.sellerId)) &&
            fieldUnchanged("buyerId") &&
            fieldUnchanged("sellerId"))
    );
    delete: false;
    list: isAuthenticated();
}

rules chat_messages {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.buyerId) ||
        isOwner(resource.sellerId) ||
        isOwner(resource.senderId)
    );
    create: isAuthenticated() && fieldEqualsAuth("senderId") && (
        fieldEqualsAuth("buyerId") ||
        (hasRole("seller") && fieldEqualsAuth("sellerId"))
    );
    update: isAuthenticated() && (
        hasRole("admin") ||
        (isOwner(resource.senderId) &&
            fieldUnchanged("senderId") &&
            fieldUnchanged("buyerId") &&
            fieldUnchanged("sellerId"))
    );
    delete: false;
    list: isAuthenticated();
}

rules chats__messages {
    read: isAuthenticated() && (
        hasRole("admin") ||
        isOwner(resource.buyerId) ||
        isOwner(resource.sellerId) ||
        isOwner(resource.senderId)
    );
    create: isAuthenticated() && fieldEqualsAuth("senderId") && (
        fieldEqualsAuth("buyerId") ||
        (hasRole("seller") && fieldEqualsAuth("sellerId"))
    );
    update: isAuthenticated() && (
        hasRole("admin") ||
        (isOwner(resource.senderId) &&
            fieldUnchanged("senderId") &&
            fieldUnchanged("buyerId") &&
            fieldUnchanged("sellerId"))
    );
    delete: false;
    list: isAuthenticated();
}

rules favorites {
    read: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    create: isAuthenticated() && (
        (fieldEqualsAuth("userId") ||
            fieldEqualsAuth("ownerId") ||
            fieldEqualsAuth("uid")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("ownerId") &&
        fieldAbsentOrEqualsAuth("uid")
    );
    update: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    ) && fieldUnchanged("userId") && fieldUnchanged("ownerId") && fieldUnchanged("uid");
    delete: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    list: isAuthenticated();
}

rules addresses {
    read: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    create: isAuthenticated() && (
        (fieldEqualsAuth("userId") ||
            fieldEqualsAuth("ownerId") ||
            fieldEqualsAuth("uid")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("ownerId") &&
        fieldAbsentOrEqualsAuth("uid")
    );
    update: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    ) && fieldUnchanged("userId") && fieldUnchanged("ownerId") && fieldUnchanged("uid");
    delete: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    list: isAuthenticated();
}

rules notifications {
    read: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    create: isAuthenticated() && (
        (fieldEqualsAuth("userId") ||
            fieldEqualsAuth("ownerId") ||
            fieldEqualsAuth("uid")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("ownerId") &&
        fieldAbsentOrEqualsAuth("uid")
    );
    update: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    ) && fieldUnchanged("userId") && fieldUnchanged("ownerId") && fieldUnchanged("uid");
    delete: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    list: isAuthenticated();
}

rules users__notifications {
    read: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    create: isAuthenticated() && (
        (fieldEqualsAuth("userId") ||
            fieldEqualsAuth("ownerId") ||
            fieldEqualsAuth("uid")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("ownerId") &&
        fieldAbsentOrEqualsAuth("uid")
    );
    update: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    ) && fieldUnchanged("userId") && fieldUnchanged("ownerId") && fieldUnchanged("uid");
    delete: isAuthenticated() && (
        isOwner(resource.userId) ||
        isOwner(resource.ownerId) ||
        isOwner(resource.uid)
    );
    list: isAuthenticated();
}

rules seller_profiles {
    read: true;
    create: isAuthenticated() && fieldEqualsAuth("uid");
    update: isAuthenticated() && isOwner(resource.uid) && fieldUnchanged("uid");
    delete: false;
    list: true;
}

rules product_questions {
    read: true;
    create: isAuthenticated() && (
        (fieldEqualsAuth("userId") || fieldEqualsAuth("uid")) &&
        fieldAbsentOrEqualsAuth("userId") &&
        fieldAbsentOrEqualsAuth("uid")
    );
    update: isAuthenticated() && (
        hasRole("admin") ||
        ((isOwner(resource.userId) || isOwner(resource.uid)) &&
            fieldUnchanged("userId") &&
            fieldUnchanged("uid"))
    );
    delete: hasRole("admin");
    list: true;
}

rules * {
    read: false;
    create: false;
    update: false;
    delete: false;
    list: false;
}
