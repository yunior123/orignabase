/// POST /auth/anonymous — Create an anonymous user and return tokens.
///
/// Anonymous users get `roles: ["anonymous"]` and can later be linked to a
/// real email/password or OAuth account via the upgrade flow.
pub async fn anonymous_sign_in(State(state): State<AuthState>) -> Result<Json<AuthResponse>> {
    let anon_id = uuid::Uuid::new_v4().to_string();
    let now = chrono::Utc::now().to_rfc3339();

    let user_data = json!({
        "email": null,
        "password_hash": null,
        "display_name": format!("Anonymous {}", &anon_id[..8]),
        "roles": ["anonymous"],
        "email_verified": false,
        "mfa_enabled": false,
        "is_anonymous": true,
        "created_at": now,
    });

    let user = state.db.create_document("users", user_data).await?;
    let user_id = user["id"]
        .as_str()
        .map(|s| s.to_string())
        .unwrap_or_else(|| user["id"].to_string());

    let roles = vec!["anonymous".to_string()];
    let access_token =
        jwt::issue_access_token(&user_id, &roles, &state.jwt_keys, state.access_ttl, false)?;
    let refresh_token = jwt::issue_refresh_token(&user_id, &state.jwt_keys, state.refresh_ttl)?;

    let mut safe_user = user.clone();
    if let Some(obj) = safe_user.as_object_mut() {
        obj.remove("password_hash");
    }

    Ok(Json(AuthResponse {
        access_token,
        refresh_token,
        user: safe_user,
    }))
}

/// POST /auth/anonymous/upgrade — Link anonymous account to email/password.
#[derive(Deserialize)]
pub struct AnonymousUpgradeRequest {
    pub email: String,
    pub password: String,
    #[serde(default)]
    pub display_name: Option<String>,
}

pub async fn anonymous_upgrade(
    State(state): State<AuthState>,
    Extension(auth): Extension<AuthContext>,
    Json(body): Json<AnonymousUpgradeRequest>,
) -> Result<Json<AuthResponse>> {
    // Must be anonymous user
    if !auth.roles.contains(&"anonymous".to_string()) {
        return Err(Error::Forbidden("Only anonymous users can upgrade".into()));
    }

    if !body.email.contains('@') || body.email.len() < 5 {
        return Err(Error::Validation("Invalid email address".into()));
    }
    if body.password.len() < 8 {
        return Err(Error::Validation(
            "Password must be at least 8 characters".into(),
        ));
    }

    // Check email not taken
    let existing = state
        .db
        .query_bind(
            "SELECT id FROM users WHERE email = $email",
            json!({ "email": body.email }),
        )
        .await?;
    if !existing.is_empty() {
        return Err(Error::Validation("Registration failed".into()));
    }

    let password_hash = password::hash_password(&body.password)?;

    // Upgrade the anonymous user to a real user
    let update_data = json!({
        "email": body.email,
        "password_hash": password_hash,
        "display_name": body.display_name.unwrap_or_default(),
        "roles": ["user"],
        "is_anonymous": false,
    });

    state
        .db
        .update_document("users", &auth.user_id, update_data)
        .await?;

    // Send verification email
    let verification_token = jwt::issue_verification_token(&auth.user_id, &state.jwt_keys)?;
    if let Some(ref email_service) = state.email_service {
        let _ = email_service
            .send_verification_email(&body.email, &verification_token, &state.base_url)
            .await;
    }

    // Issue new tokens with upgraded roles
    let roles = vec!["user".to_string()];
    let access_token = jwt::issue_access_token(
        &auth.user_id,
        &roles,
        &state.jwt_keys,
        state.access_ttl,
        false,
    )?;
    let refresh_token =
        jwt::issue_refresh_token(&auth.user_id, &state.jwt_keys, state.refresh_ttl)?;

    let user = state
        .db
        .query_bind(
            "SELECT * FROM type::thing('users', $uid) LIMIT 1",
            json!({ "uid": auth.user_id }),
        )
        .await?;

    let mut safe_user = user.first().cloned().unwrap_or(json!({}));
    if let Some(obj) = safe_user.as_object_mut() {
        obj.remove("password_hash");
    }

    Ok(Json(AuthResponse {
        access_token,
        refresh_token,
        user: safe_user,
    }))
}

// ── Magic Link Sign-In ──

#[derive(Deserialize)]
pub struct MagicLinkRequest {
    pub email: String,
}

#[derive(Deserialize)]
pub struct VerifyMagicLinkRequest {
    pub token: String,
}

/// POST /auth/magic-link — Send a magic link email for passwordless sign-in.
pub async fn send_magic_link(
    State(state): State<AuthState>,
    Json(body): Json<MagicLinkRequest>,
) -> Result<Json<serde_json::Value>> {
    if !body.email.contains('@') || body.email.len() < 5 {
        return Err(Error::Validation("Invalid email address".into()));
    }

    // Generate a single-use token (15-min TTL)
    let token_id = uuid::Uuid::new_v4().to_string();
    let now = chrono::Utc::now();
    let expires_at = (now + chrono::Duration::minutes(15)).to_rfc3339();

    // Store the magic link token in DB (single-use, tied to email)
    let token_data = json!({
        "email": body.email,
        "token_id": token_id,
        "used": false,
        "expires_at": expires_at,
        "created_at": now.to_rfc3339(),
    });
    state.db.create_document("_magic_links", token_data).await?;

    // Send the email
    if let Some(ref email_service) = state.email_service {
        let _ = email_service
            .send_magic_link_email(&body.email, &token_id, &state.base_url)
            .await;
    }

    // Always return success (don't reveal if email exists — prevents enumeration)
    Ok(Json(json!({
        "message": "If that email is registered, a magic link has been sent.",
        // In dev mode (no email service), return token for testing
        "token": if state.email_service.is_none() { Some(&token_id) } else { None },
    })))
}

/// POST /auth/verify-magic-link — Verify a magic link token and sign in.
pub async fn verify_magic_link(
    State(state): State<AuthState>,
    Json(body): Json<VerifyMagicLinkRequest>,
) -> Result<Json<AuthResponse>> {
    // Find the magic link token
    let tokens = state
        .db
        .query_bind(
            "SELECT * FROM _magic_links WHERE token_id = $token_id AND used = false LIMIT 1",
            json!({ "token_id": body.token }),
        )
        .await?;

    let token_doc = tokens
        .first()
        .ok_or_else(|| Error::Auth("Invalid or expired magic link".into()))?;

    // Check expiration
    let expires_at = token_doc["expires_at"]
        .as_str()
        .ok_or_else(|| Error::Auth("Invalid token".into()))?;
    let expires = chrono::DateTime::parse_from_rfc3339(expires_at)
        .map_err(|_| Error::Auth("Invalid token expiration".into()))?;
    if chrono::Utc::now() > expires {
        return Err(Error::Auth("Magic link has expired".into()));
    }

    // Mark token as used (single-use)
    let token_db_id = token_doc["id"].as_str().unwrap_or("");
    state
        .db
        .query_bind(
            "UPDATE type::thing('_magic_links', $tid) SET used = true",
            json!({ "tid": token_db_id }),
        )
        .await?;

    // Find or create user by email
    let email = token_doc["email"]
        .as_str()
        .ok_or_else(|| Error::Auth("Invalid token".into()))?;

    let existing = state
        .db
        .query_bind(
            "SELECT * FROM users WHERE email = $email LIMIT 1",
            json!({ "email": email }),
        )
        .await?;

    let (user_id, user, roles) = if let Some(existing_user) = existing.first() {
        let uid = existing_user["id"]
            .as_str()
            .map(|s| s.to_string())
            .unwrap_or_else(|| existing_user["id"].to_string());
        let roles: Vec<String> = existing_user["roles"]
            .as_array()
            .map(|arr| {
                arr.iter()
                    .filter_map(|v| v.as_str().map(String::from))
                    .collect()
            })
            .unwrap_or_else(|| vec!["user".to_string()]);

        // Mark email as verified (they proved ownership via magic link)
        state
            .db
            .query_bind(
                "UPDATE type::thing('users', $uid) SET email_verified = true",
                json!({ "uid": uid }),
            )
            .await?;

        (uid, existing_user.clone(), roles)
    } else {
        // Create new user (passwordless account)
        let now = chrono::Utc::now().to_rfc3339();
        let user_data = json!({
            "email": email,
            "password_hash": null,
            "display_name": email.split('@').next().unwrap_or("User"),
            "roles": ["user"],
            "email_verified": true,
            "mfa_enabled": false,
            "is_anonymous": false,
            "created_at": now,
        });

        let user = state.db.create_document("users", user_data).await?;
        let uid = user["id"]
            .as_str()
            .map(|s| s.to_string())
            .unwrap_or_else(|| user["id"].to_string());

        // Send welcome email
        if let Some(ref email_service) = state.email_service {
            let _ = email_service.send_welcome_email(email).await;
        }

        (uid, user, vec!["user".to_string()])
    };

    // Get custom claims
    let custom_claims = user
        .get("custom_claims")
        .cloned()
        .unwrap_or(serde_json::Value::Null);

    let access_token = issue_access_token_with_claims(
        &user_id,
        &roles,
        &state.jwt_keys,
        state.access_ttl,
        true, // email verified via magic link
        custom_claims,
    )?;
    let refresh_token = jwt::issue_refresh_token(&user_id, &state.jwt_keys, state.refresh_ttl)?;

    let mut safe_user = user;
    if let Some(obj) = safe_user.as_object_mut() {
        obj.remove("password_hash");
    }

    Ok(Json(AuthResponse {
        access_token,
        refresh_token,
        user: safe_user,
    }))
}

/// Build the auth router.
pub fn auth_router(state: AuthState) -> axum::Router {
    let jwt_keys = Arc::new(state.jwt_keys.clone());
    axum::Router::new()
        .route("/auth/register", axum::routing::post(register))
        .route("/auth/login", axum::routing::post(login))
        .route("/auth/refresh", axum::routing::post(refresh))
        .route(
            "/auth/forgot-password",
            axum::routing::post(forgot_password),
        )
        .route("/auth/reset-password", axum::routing::post(reset_password))
        .route("/auth/providers", axum::routing::get(auth_providers))
        .route("/auth/google/start", axum::routing::get(google_oauth_start))
        .route(
            "/auth/google/callback",
            axum::routing::get(google_oauth_callback),
        )
        .route("/auth/google", axum::routing::post(google_sign_in))
        .route("/auth/apple", axum::routing::post(apple_sign_in))
        .route("/auth/oidc", axum::routing::post(oidc_sign_in))
        // Email verification
        .route("/auth/verify-email", axum::routing::post(verify_email))
        .route(
            "/auth/send-verification",
            axum::routing::post(send_verification),
        )
        // MFA / TOTP
        .route("/auth/mfa/setup", axum::routing::post(mfa_setup))
        .route(
            "/auth/mfa/verify-setup",
            axum::routing::post(mfa_verify_setup),
        )
        .route("/auth/mfa/challenge", axum::routing::post(mfa_challenge))
        .route("/auth/mfa/recovery", axum::routing::post(mfa_recovery))
        .route("/auth/mfa", axum::routing::delete(mfa_disable))
        // Anonymous auth
        .route("/auth/anonymous", axum::routing::post(anonymous_sign_in))
        .route(
            "/auth/anonymous/upgrade",
            axum::routing::post(anonymous_upgrade),
        )
        // Magic link (passwordless)
        .route("/auth/magic-link", axum::routing::post(send_magic_link))
        .route(
            "/auth/verify-magic-link",
            axum::routing::post(verify_magic_link),
        )
        // Admin user management
        .route("/admin/users", axum::routing::get(admin_list_users))
        .route("/admin/users", axum::routing::post(admin_create_user))
        .route("/admin/users/{user_id}", axum::routing::get(admin_get_user))
        .route(
            "/admin/users/{user_id}",
            axum::routing::patch(admin_update_user),
        )
        .route(
            "/admin/users/{user_id}",
            axum::routing::delete(admin_delete_user),
        )
        .route(
            "/admin/users/{user_id}/claims",
            axum::routing::put(admin_set_claims),
        )
        // Admin email templates
        .route(
            "/admin/email-templates",
            axum::routing::get(admin_list_templates),
        )
        .route(
            "/admin/email-templates/{template_name}",
            axum::routing::get(admin_get_template),
        )
        .route(
            "/admin/email-templates/{template_name}",
            axum::routing::put(admin_update_template),
        )
        .route(
            "/admin/email-templates/{template_name}/reset",
            axum::routing::post(admin_reset_template),
        )
        // Security / login tracking
        .route(
            "/api/security/login-history",
            axum::routing::get(login_tracking::get_login_history),
        )
        .route(
            "/api/security/known-devices",
            axum::routing::get(login_tracking::get_known_devices),
        )
        .route(
            "/api/security/known-devices/{id}",
            axum::routing::delete(login_tracking::delete_known_device),
        )
        .route(
            "/api/security/alerts",
            axum::routing::get(login_tracking::get_security_alerts),
        )
        .route(
            "/api/security/alerts/{id}/acknowledge",
            axum::routing::post(login_tracking::acknowledge_alert),
        )
        .with_state(state)
        .layer(axum::middleware::from_fn(auth_extractor))
        .layer(Extension(jwt_keys))
}

