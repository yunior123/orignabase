/// POST /auth/forgot-password — Generate a password reset token.
/// In production, this would send an email. For now, it returns the token directly.
pub async fn forgot_password(
    State(state): State<AuthState>,
    Json(body): Json<ForgotPasswordRequest>,
) -> Result<Json<serde_json::Value>> {
    // Find user by email
    let users = state
        .db
        .query_bind(
            "SELECT id FROM users WHERE email = $email",
            json!({ "email": body.email }),
        )
        .await?;

    // Always return success to prevent email enumeration
    let Some(user) = users.first() else {
        return Ok(Json(
            json!({ "message": "If the email exists, a reset link has been sent" }),
        ));
    };

    let user_id = user["id"]
        .as_str()
        .map(|s| s.to_string())
        .unwrap_or_else(|| user["id"].to_string());

    // Generate a short-lived reset token (1 hour)
    let reset_token = jwt::issue_reset_token(&user_id, &state.jwt_keys)?;

    // Store the reset token hash in the user record
    let token_hash = hash_token(&reset_token);
    state
        .db
        .update_document(
            "users",
            &user_id,
            json!({
                "reset_token_hash": token_hash,
                "reset_token_expires": chrono::Utc::now().timestamp() + 3600,
            }),
        )
        .await?;

    // Send reset email if service is configured
    if let Some(ref email_service) = state.email_service {
        let email = user["email"].as_str().unwrap_or_default();
        let _ = email_service
            .send_reset_email(email, &reset_token, &state.base_url)
            .await;
        Ok(Json(json!({
            "message": "If the email exists, a reset link has been sent",
        })))
    } else {
        // Dev mode: return token directly
        Ok(Json(json!({
            "message": "If the email exists, a reset link has been sent",
            "reset_token": reset_token,
        })))
    }
}

/// POST /auth/reset-password — Reset password using a valid reset token.
pub async fn reset_password(
    State(state): State<AuthState>,
    Json(body): Json<ResetPasswordRequest>,
) -> Result<Json<serde_json::Value>> {
    if body.new_password.len() < 8 {
        return Err(Error::Validation(
            "Password must be at least 8 characters".into(),
        ));
    }

    // Verify the reset token
    let claims = jwt::verify_token(&body.token, &state.jwt_keys)?;
    if claims.typ != "password_reset" {
        return Err(Error::Auth("Invalid token type for password reset".into()));
    }

    // Look up the user and verify the token hash matches
    let users = state
        .db
        .query_bind(
            "SELECT * FROM type::thing($uid)",
            json!({ "uid": claims.sub }),
        )
        .await?;

    let user = users
        .first()
        .ok_or_else(|| Error::Auth("User not found".into()))?;

    let stored_hash = user["reset_token_hash"]
        .as_str()
        .ok_or_else(|| Error::Auth("No reset token pending".into()))?;

    let token_hash = hash_token(&body.token);
    if stored_hash != token_hash {
        return Err(Error::Auth("Invalid or expired reset token".into()));
    }

    // Check expiry
    let expires = user["reset_token_expires"].as_i64().unwrap_or(0);
    if chrono::Utc::now().timestamp() > expires {
        return Err(Error::Auth("Reset token has expired".into()));
    }

    // Hash new password and update
    let new_hash = password::hash_password(&body.new_password)?;
    let user_id = claims.sub;

    state
        .db
        .update_document(
            "users",
            &user_id,
            json!({
                "password_hash": new_hash,
                "reset_token_hash": null,
                "reset_token_expires": null,
            }),
        )
        .await?;

    Ok(Json(json!({ "message": "Password reset successfully" })))
}

/// SHA-256 hash for token storage (prevents raw token storage in DB).
fn hash_token(input: &str) -> String {
    use sha2::{Digest, Sha256};
    let mut hasher = Sha256::new();
    hasher.update(input.as_bytes());
    hex::encode(hasher.finalize())
}

