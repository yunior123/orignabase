/// GET /auth/providers — public provider readiness for clients and E2E checks.
pub async fn auth_providers(State(state): State<AuthState>) -> Json<AuthProvidersResponse> {
    Json(AuthProvidersResponse {
        google: ProviderAvailability {
            enabled: google_web_provider_enabled(&state),
            client_id_configured: google_client_id_configured(&state),
            client_secret_configured: google_client_secret_configured(&state),
        },
        apple: ProviderAvailability {
            enabled: state
                .apple_service_id
                .as_deref()
                .is_some_and(|value| !value.trim().is_empty())
                && state
                    .apple_team_id
                    .as_deref()
                    .is_some_and(|value| !value.trim().is_empty())
                && state
                    .apple_key_id
                    .as_deref()
                    .is_some_and(|value| !value.trim().is_empty())
                && state
                    .apple_private_key
                    .as_deref()
                    .is_some_and(|value| !value.trim().is_empty()),
            client_id_configured: state
                .apple_service_id
                .as_deref()
                .is_some_and(|value| !value.trim().is_empty()),
            client_secret_configured: state
                .apple_private_key
                .as_deref()
                .is_some_and(|value| !value.trim().is_empty()),
        },
        oidc: ProviderAvailability {
            enabled: state
                .oidc_issuer_url
                .as_deref()
                .is_some_and(|value| !value.trim().is_empty())
                && state
                    .oidc_client_id
                    .as_deref()
                    .is_some_and(|value| !value.trim().is_empty()),
            client_id_configured: state
                .oidc_client_id
                .as_deref()
                .is_some_and(|value| !value.trim().is_empty()),
            client_secret_configured: false,
        },
    })
}

/// GET /auth/google/start — begin the backend-owned Google OAuth web flow.
pub async fn google_oauth_start(
    State(state): State<AuthState>,
    Query(query): Query<GoogleOAuthStartRequest>,
) -> Result<Redirect> {
    let client_id = state
        .google_client_id
        .as_deref()
        .filter(|value| !value.trim().is_empty())
        .ok_or_else(|| Error::Config("Google OAuth client ID not configured".into()))?;
    let _client_secret = state
        .google_client_secret
        .as_deref()
        .filter(|value| !value.trim().is_empty())
        .ok_or_else(|| Error::Config("Google OAuth client secret not configured".into()))?;

    let redirect_to = validate_google_redirect_target(&state, &query.redirect_to)?;
    let state_token = issue_google_oauth_state(&state, &redirect_to)?;

    let google_url = reqwest::Url::parse_with_params(
        "https://accounts.google.com/o/oauth2/v2/auth",
        &[
            ("client_id", client_id),
            ("redirect_uri", &callback_url(&state)),
            ("response_type", "code"),
            ("scope", "openid email profile"),
            ("access_type", "offline"),
            ("include_granted_scopes", "true"),
            ("prompt", "select_account"),
            ("state", &state_token),
        ],
    )
    .map_err(|e| Error::Config(format!("Failed to build Google OAuth URL: {e}")))?;

    Ok(Redirect::temporary(google_url.as_str()))
}

/// GET /auth/google/callback — finish the backend-owned Google OAuth web flow.
pub async fn google_oauth_callback(
    State(state): State<AuthState>,
    Query(query): Query<GoogleOAuthCallbackRequest>,
) -> Result<Redirect> {
    let fallback_redirect = frontend_fallback_redirect(&state);

    if let Some(error) = query.error.as_deref() {
        let redirect_target = match query.state.as_deref() {
            Some(token) => decode_google_oauth_state(&state, token)
                .map(|claims| claims.redirect_to)
                .unwrap_or_else(|_| fallback_redirect.clone()),
            None => fallback_redirect.clone(),
        };
        let description = query.error_description.as_deref().unwrap_or_default();
        let fragment = if description.is_empty() {
            format!("ob_error={error}")
        } else {
            format!("ob_error={error}&ob_error_description={description}")
        };
        return Ok(build_redirect_with_fragment(&redirect_target, &fragment));
    }

    let state_token = query
        .state
        .as_deref()
        .ok_or_else(|| Error::Validation("Missing OAuth state".into()))?;
    let claims = decode_google_oauth_state(&state, state_token)?;
    let authorization_code = query
        .code
        .as_deref()
        .ok_or_else(|| Error::Validation("Missing Google authorization code".into()))?;

    let client_id = state
        .google_client_id
        .as_deref()
        .filter(|value| !value.trim().is_empty())
        .ok_or_else(|| Error::Config("Google OAuth client ID not configured".into()))?;
    let client_secret = state
        .google_client_secret
        .as_deref()
        .filter(|value| !value.trim().is_empty())
        .ok_or_else(|| Error::Config("Google OAuth client secret not configured".into()))?;

    let user_info = oauth::exchange_google_authorization_code(
        authorization_code,
        client_id,
        client_secret,
        &callback_url(&state),
    )
    .await?;
    let Json(auth) = oauth_find_or_create_user(&state, user_info).await?;

    let fragment = format!(
        "ob_access_token={}&ob_refresh_token={}&ob_provider=google",
        auth.access_token, auth.refresh_token
    );

    Ok(build_redirect_with_fragment(&claims.redirect_to, &fragment))
}

/// POST /auth/google — Sign in with Google.
pub async fn google_sign_in(
    State(state): State<AuthState>,
    Json(body): Json<GoogleSignInRequest>,
) -> Result<Json<AuthResponse>> {
    let client_id = state
        .google_client_id
        .as_deref()
        .ok_or_else(|| Error::Config("Google OAuth not configured".into()))?;

    let user_info = oauth::verify_google_id_token(&body.id_token, client_id).await?;
    oauth_find_or_create_user(&state, user_info).await
}

/// POST /auth/apple — Sign in with Apple.
pub async fn apple_sign_in(
    State(state): State<AuthState>,
    Json(body): Json<AppleSignInRequest>,
) -> Result<Json<AuthResponse>> {
    let service_id = state
        .apple_service_id
        .as_deref()
        .ok_or_else(|| Error::Config("Apple OAuth not configured".into()))?;
    let team_id = state
        .apple_team_id
        .as_deref()
        .ok_or_else(|| Error::Config("Apple team_id not configured".into()))?;
    let key_id = state
        .apple_key_id
        .as_deref()
        .ok_or_else(|| Error::Config("Apple key_id not configured".into()))?;
    let private_key = state
        .apple_private_key
        .as_deref()
        .ok_or_else(|| Error::Config("Apple private key not configured".into()))?;

    // Generate Apple client secret JWT
    let client_secret =
        oauth::generate_apple_client_secret(team_id, key_id, service_id, private_key)?;

    let mut user_info =
        oauth::verify_apple_auth_code(&body.authorization_code, service_id, &client_secret).await?;

    // Apple only sends display_name on first sign-in (from client)
    if user_info.display_name.is_none() {
        user_info.display_name = body.display_name;
    }

    oauth_find_or_create_user(&state, user_info).await
}

/// POST /auth/oidc — Sign in with a generic OIDC provider.
pub async fn oidc_sign_in(
    State(state): State<AuthState>,
    Json(body): Json<OidcSignInRequest>,
) -> Result<Json<AuthResponse>> {
    let issuer_url = state
        .oidc_issuer_url
        .as_deref()
