#[derive(Debug, Clone, Serialize, Deserialize)]
struct GoogleOAuthStateClaims {
    sub: String,
    iat: i64,
    exp: i64,
    typ: String,
    nonce: String,
    redirect_to: String,
}

fn google_client_id_configured(state: &AuthState) -> bool {
    state
        .google_client_id
        .as_deref()
        .is_some_and(|value| !value.trim().is_empty())
}

fn google_client_secret_configured(state: &AuthState) -> bool {
    state
        .google_client_secret
        .as_deref()
        .is_some_and(|value| !value.trim().is_empty())
}

fn google_web_provider_enabled(state: &AuthState) -> bool {
    google_client_id_configured(state) && google_client_secret_configured(state)
}

fn jwt_header(keys: &JwtKeys) -> Header {
    match keys {
        JwtKeys::Rsa { .. } => Header::new(Algorithm::RS256),
        JwtKeys::Hmac { .. } => Header::default(),
    }
}

fn jwt_encoding_key(keys: &JwtKeys) -> EncodingKey {
    match keys {
        JwtKeys::Rsa { encoding, .. } => encoding.clone(),
        JwtKeys::Hmac { secret } => EncodingKey::from_secret(secret.as_bytes()),
    }
}

fn jwt_decoding_key(keys: &JwtKeys) -> DecodingKey {
    match keys {
        JwtKeys::Rsa { decoding, .. } => decoding.clone(),
        JwtKeys::Hmac { secret } => DecodingKey::from_secret(secret.as_bytes()),
    }
}

fn jwt_validation(keys: &JwtKeys) -> Validation {
    match keys {
        JwtKeys::Rsa { .. } => Validation::new(Algorithm::RS256),
        JwtKeys::Hmac { .. } => Validation::default(),
    }
}

fn callback_url(state: &AuthState) -> String {
    format!(
        "{}/auth/google/callback",
        state.base_url.trim_end_matches('/')
    )
}

fn frontend_fallback_redirect(state: &AuthState) -> String {
    let Ok(base_url) = reqwest::Url::parse(&state.base_url) else {
        return state.base_url.clone();
    };
    let Some(host) = base_url.host_str() else {
        return state.base_url.clone();
    };

    let fallback = match host {
        "api.orignagta.ca" => "https://orignagta.ca",
        "api-staging.orignagta.ca" => "https://orignagta-staging.web.app",
        "localhost" | "127.0.0.1" => "http://localhost:5001",
        _ if host.starts_with("api.") => {
            return format!(
                "{}://{}",
                base_url.scheme(),
                host.trim_start_matches("api.")
            );
        }
        _ => return format!("{}://{}", base_url.scheme(), host),
    };

    fallback.to_string()
}

fn validate_google_redirect_target(state: &AuthState, redirect_to: &str) -> Result<String> {
    let redirect_url = reqwest::Url::parse(redirect_to)
        .map_err(|_| Error::Validation("Invalid redirect_to URL".into()))?;

    if redirect_url.fragment().is_some() {
        return Err(Error::Validation(
            "redirect_to must not include a fragment".into(),
        ));
    }

    let redirect_origin = redirect_url.origin().ascii_serialization();
    let mut allowed_origins = vec![frontend_fallback_redirect(state)];

    if let Ok(base_url) = reqwest::Url::parse(&state.base_url) {
        allowed_origins.push(base_url.origin().ascii_serialization());
        if let Some(host) = base_url.host_str() {
            if host.starts_with("api.") {
                allowed_origins.push(format!(
                    "{}://{}",
                    base_url.scheme(),
                    host.trim_start_matches("api.")
                ));
            }
        }
    }

    if !allowed_origins
        .iter()
        .any(|origin| origin == &redirect_origin)
    {
        return Err(Error::Validation(
            "redirect_to origin is not allowed".into(),
        ));
    }

    Ok(redirect_url.to_string())
}

fn issue_google_oauth_state(state: &AuthState, redirect_to: &str) -> Result<String> {
    let now = Utc::now().timestamp();
    let nonce = uuid::Uuid::new_v4().to_string();
    let claims = GoogleOAuthStateClaims {
        sub: "google_oauth".to_string(),
        iat: now,
        exp: now + 600,
        typ: "oauth_google_state".to_string(),
        nonce: nonce.clone(),
        redirect_to: redirect_to.to_string(),
    };

    state.oauth_state_nonces.insert(nonce, claims.exp);

    encode(
        &jwt_header(&state.jwt_keys),
        &claims,
        &jwt_encoding_key(&state.jwt_keys),
    )
    .map_err(|e| Error::Auth(format!("OAuth state token creation failed: {e}")))
}

fn decode_google_oauth_state(state: &AuthState, token: &str) -> Result<GoogleOAuthStateClaims> {
    let data = decode::<GoogleOAuthStateClaims>(
        token,
        &jwt_decoding_key(&state.jwt_keys),
        &jwt_validation(&state.jwt_keys),
    )
    .map_err(|e| Error::Auth(format!("OAuth state verification failed: {e}")))?;

    let claims = data.claims;
    if claims.typ != "oauth_google_state" {
        return Err(Error::Auth("Invalid OAuth state type".into()));
    }

    let now = Utc::now().timestamp();
    state.oauth_state_nonces.retain(|_, exp| *exp > now);
    let consumed = state.oauth_state_nonces.remove(&claims.nonce);
    if consumed.is_none() {
        return Err(Error::Auth("OAuth state is invalid or already used".into()));
    }

    Ok(claims)
}

fn build_redirect_with_fragment(base: &str, fragment: &str) -> Redirect {
    if let Ok(mut url) = reqwest::Url::parse(base) {
        url.set_fragment(Some(fragment));
        return Redirect::temporary(url.as_str());
    }
    Redirect::temporary(base)
}

fn ensure_user_not_disabled(user: &serde_json::Value) -> Result<()> {
    if user["disabled"].as_bool().unwrap_or(false) {
        return Err(Error::Auth("Account is disabled".into()));
    }
    Ok(())
}

/// POST /auth/register
pub async fn register(
    State(state): State<AuthState>,
    Json(body): Json<RegisterRequest>,
) -> Result<Json<AuthResponse>> {
    // Validate email format (basic)
    if !body.email.contains('@') || body.email.len() < 5 {
        return Err(Error::Validation("Invalid email address".into()));
    }
    if body.password.len() < 8 {
        return Err(Error::Validation(
            "Password must be at least 8 characters".into(),
        ));
    }

    // Check if email already exists (parameterized query — safe from injection)
    let existing = state
        .db
        .query_bind(
            "SELECT id FROM users WHERE email = $email",
            json!({ "email": body.email }),
        )
        .await?;
    if !existing.is_empty() {
        return Err(Error::Validation("Registration failed".into()));
    }

    // Hash password
    let password_hash = password::hash_password(&body.password)?;

    // Create user document
    let user_data = json!({
        "email": body.email,
        "password_hash": password_hash,
        "display_name": body.display_name.unwrap_or_default(),
        "roles": ["user"],
        "email_verified": false,
        "mfa_enabled": false,
        "created_at": chrono::Utc::now().to_rfc3339(),
    });

    let user = state.db.create_document("users", user_data).await?;
    let user_id = user["id"]
        .as_str()
        .map(|s| s.to_string())
        .unwrap_or_else(|| user["id"].to_string());

    // Send verification email if email service is configured
    let verification_token = jwt::issue_verification_token(&user_id, &state.jwt_keys)?;

    if let Some(ref email_service) = state.email_service {
        let _ = email_service
            .send_verification_email(&body.email, &verification_token, &state.base_url)
            .await;
    }

    // Strip password hash from response
    let mut safe_user = user.clone();
    if let Some(obj) = safe_user.as_object_mut() {
        obj.remove("password_hash");
    }

    // If email verification is required, do NOT issue tokens yet
    if state.require_email_verification {
        return Ok(Json(AuthResponse {
            access_token: String::new(),
            refresh_token: String::new(),
            user: json!({
                "message": "Registration successful. Please verify your email.",
                "email_verification_required": true,
                "user": safe_user,
            }),
        }));
    }

    // Issue tokens (only when email verification is not required)
    let roles = vec!["user".to_string()];
    let access_token =
        jwt::issue_access_token(&user_id, &roles, &state.jwt_keys, state.access_ttl, false)?;
    let refresh_token = jwt::issue_refresh_token(&user_id, &state.jwt_keys, state.refresh_ttl)?;

    Ok(Json(AuthResponse {
        access_token,
        refresh_token,
        user: safe_user,
    }))
}

/// POST /auth/login
pub async fn login(
    State(state): State<AuthState>,
    headers: HeaderMap,
    Json(body): Json<LoginRequest>,
) -> Result<Json<AuthResponse>> {
    // Find user by email (parameterized query — safe from injection)
    let users = state
        .db
        .query_bind(
            "SELECT * FROM users WHERE email = $email",
            json!({ "email": body.email }),
        )
        .await?;

    let user = match users.first() {
        Some(u) => u,
        None => {
            // Timing attack prevention: run a dummy argon2id hash so the response
            // time is indistinguishable from a real password verification.
            // This prevents email enumeration via timing side-channel.
            password::dummy_verify(&body.password);
            return Err(Error::Auth("Invalid email or password".into()));
        }
    };

    // Verify password
    let hash = user["password_hash"]
        .as_str()
        .ok_or_else(|| Error::Auth("Invalid user record".into()))?;

    ensure_user_not_disabled(user)?;

    let user_id = user["id"]
        .as_str()
        .map(|s| s.to_string())
        .unwrap_or_else(|| user["id"].to_string());

    if !password::verify_password(&body.password, hash)? {
        // Record failed login attempt (best-effort)
        login_tracking::on_login_failure(&state.db, &user_id, &headers).await;
        return Err(Error::Auth("Invalid email or password".into()));
    }

    let roles: Vec<String> = user["roles"]
        .as_array()
        .map(|arr| {
            arr.iter()
                .filter_map(|v| v.as_str().map(String::from))
                .collect()
        })
        .unwrap_or_default();

    // Check email verification requirement
    let email_verified = user["email_verified"].as_bool().unwrap_or(false);
    if state.require_email_verification && !email_verified {
        return Err(Error::Auth(
            "Email not verified. Please check your inbox.".into(),
        ));
    }

    // Check if MFA is enabled — if so, return challenge token instead of full tokens
    let mfa_enabled = user["mfa_enabled"].as_bool().unwrap_or(false);
    if mfa_enabled {
        let challenge_token = jwt::issue_challenge_token(&user_id, &state.jwt_keys)?;
        return Ok(Json(AuthResponse {
            access_token: String::new(),
            refresh_token: String::new(),
            user: json!({
                "mfa_required": true,
                "challenge_token": challenge_token,
            }),
        }));
    }

    let custom_claims = user
        .get("custom_claims")
        .cloned()
        .unwrap_or(serde_json::Value::Null);

    let access_token = issue_access_token_with_claims(
        &user_id,
        &roles,
        &state.jwt_keys,
        state.access_ttl,
        email_verified,
        custom_claims,
    )?;
    let refresh_token = jwt::issue_refresh_token(&user_id, &state.jwt_keys, state.refresh_ttl)?;

    // Record session
    let _ = record_session(&state.db, &user_id, "email").await;

    // Record login for suspicious-device detection (best-effort, non-blocking)
    login_tracking::on_login_success(&state.db, &user_id, &headers).await;

    let mut safe_user = user.clone();
    if let Some(obj) = safe_user.as_object_mut() {
        obj.remove("password_hash");
    }

    Ok(Json(AuthResponse {
        access_token,
        refresh_token,
        user: safe_user,
    }))
}

/// POST /auth/refresh
pub async fn refresh(
    State(state): State<AuthState>,
    Json(body): Json<RefreshRequest>,
) -> Result<Json<serde_json::Value>> {
    let claims = jwt::verify_token(&body.refresh_token, &state.jwt_keys)?;

    if claims.typ != "refresh" {
        return Err(Error::Auth("Invalid token type".into()));
    }

    // Look up user to get current roles
    // Use type::thing() to convert the string record ID back to a RecordId
    let users = state
        .db
        .query_bind(
            "SELECT * FROM type::thing($uid)",
            json!({ "uid": claims.sub }),
        )
        .await?;

    let user = users
        .first()
        .ok_or_else(|| Error::Auth("User not found".into()))?;
    ensure_user_not_disabled(user)?;

    let roles: Vec<String> = user["roles"]
        .as_array()
        .map(|arr| {
            arr.iter()
                .filter_map(|v| v.as_str().map(String::from))
                .collect()
        })
        .unwrap_or_default();

    let email_verified = user["email_verified"].as_bool().unwrap_or(false);
    let custom_claims = user
        .get("custom_claims")
        .cloned()
        .unwrap_or(serde_json::Value::Null);

    let access_token = issue_access_token_with_claims(
        &claims.sub,
        &roles,
        &state.jwt_keys,
        state.access_ttl,
        email_verified,
        custom_claims,
    )?;
    let refresh_token = jwt::issue_refresh_token(&claims.sub, &state.jwt_keys, state.refresh_ttl)?;

    Ok(Json(json!({
        "access_token": access_token,
        "refresh_token": refresh_token,
    })))
}

// ── Session Tracking ──

/// Record a login session for audit and anomaly detection.
async fn record_session(
    db: &ob_database::DatabaseClient,
    user_id: &str,
    method: &str,
) -> Result<()> {
    let session_data = json!({
        "user_id": user_id,
        "method": method,
        "logged_in_at": chrono::Utc::now().to_rfc3339(),
        "session_id": uuid::Uuid::new_v4().to_string(),
    });
    let _ = db.create_document("_sessions", session_data).await;
    Ok(())
}

