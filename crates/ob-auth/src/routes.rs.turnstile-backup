    if let Some(ref email_service) = state.email_service {
        let email = user["email"].as_str().unwrap_or_default();
        let _ = email_service.send_mfa_alert(email, "disabled").await;
    }

    Ok(Json(json!({ "message": "MFA disabled successfully" })))
}

