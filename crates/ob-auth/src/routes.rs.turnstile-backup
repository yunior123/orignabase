    pub db: ob_database::DatabaseClient,
    pub jwt_keys: JwtKeys,
    pub access_ttl: u64,
    pub refresh_ttl: u64,
    pub google_client_id: Option<String>,
    pub google_client_secret: Option<String>,
    pub apple_team_id: Option<String>,
    pub apple_key_id: Option<String>,
    pub apple_service_id: Option<String>,
    pub apple_private_key: Option<String>,
    pub oidc_issuer_url: Option<String>,
    pub oidc_client_id: Option<String>,
    /// Email service (None = skip email sending, return tokens in response for dev)
    pub email_service: Option<EmailService>,
    /// Whether to require email verification before login
    pub require_email_verification: bool,
    /// AES-256 key for encrypting TOTP secrets at rest (32 bytes)
    pub totp_encryption_key: Option<[u8; 32]>,
    /// Base URL for email links (e.g. "https://app.orignabase.com")
    pub base_url: String,
    /// Short-lived OAuth state nonce store to reject replayed callbacks.
    pub oauth_state_nonces: Arc<dashmap::DashMap<String, i64>>,
    /// Cloudflare Turnstile secret key
    pub turnstile_secret_key: Option<String>,
}

