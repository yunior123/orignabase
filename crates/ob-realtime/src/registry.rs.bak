use dashmap::DashMap;
use serde::{Deserialize, Serialize};
use std::collections::HashSet;
use std::sync::Arc;
use tokio::sync::mpsc;

/// A unique subscription identifier.
pub type SubscriptionId = String;

/// A message sent to a WebSocket client.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct RealtimeMessage {
    pub subscription_id: SubscriptionId,
    pub event: ChangeEvent,
}

/// A change event from the database.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ChangeEvent {
    pub action: ChangeAction,
    pub collection: String,
    pub document_id: String,
    pub data: serde_json::Value,
    #[serde(default)]
    pub before_data: Option<serde_json::Value>,
    #[serde(default)]
    pub after_data: Option<serde_json::Value>,
    pub timestamp: String,
}

#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
#[serde(rename_all = "lowercase")]
pub enum ChangeAction {
    Create,
    Update,
    Delete,
}

/// A subscription entry tracking what a client is listening to.
#[derive(Debug, Clone)]
pub struct Subscription {
    pub id: SubscriptionId,
    pub collection: String,
    pub filter_hash: u64,
    /// Optional document ID for document-level subscriptions.
    /// When set, only changes to this specific document trigger notifications.
    pub document_id: Option<String>,
    pub user_id: Option<String>,
    pub sender: mpsc::Sender<RealtimeMessage>,
}

/// Presence info for a connected user.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct PresenceInfo {
    pub user_id: String,
    pub connection_id: String,
    pub status: String,
    pub last_seen: String,
    #[serde(default)]
    pub metadata: serde_json::Value,
}

/// Thread-safe registry of all active subscriptions.
///
/// Maps: `(collection, filter_hash)` → set of subscription IDs
/// Maps: `subscription_id` → Subscription
pub struct SubscriptionRegistry {
    /// subscription_id → Subscription
    subscriptions: DashMap<SubscriptionId, Subscription>,
    /// (collection, filter_hash) → set of subscription IDs
    dependency_map: DashMap<(String, u64), HashSet<SubscriptionId>>,
    /// connection_id → set of subscription IDs (for cleanup on disconnect)
    connections: DashMap<String, HashSet<SubscriptionId>>,
    /// user_id → PresenceInfo (online users)
    presence: DashMap<String, PresenceInfo>,
}

impl SubscriptionRegistry {
    pub fn new() -> Arc<Self> {
        Arc::new(Self {
            subscriptions: DashMap::new(),
            dependency_map: DashMap::new(),
            connections: DashMap::new(),
            presence: DashMap::new(),
        })
    }

    /// Register a new subscription.
    pub fn subscribe(&self, connection_id: &str, subscription: Subscription) {
        let sub_id = subscription.id.clone();
        let key = (subscription.collection.clone(), subscription.filter_hash);

        // Add to dependency map
        self.dependency_map
            .entry(key)
            .or_default()
            .insert(sub_id.clone());

        // Track by connection for cleanup
        self.connections
            .entry(connection_id.to_string())
            .or_default()
            .insert(sub_id.clone());

        // Store subscription
        self.subscriptions.insert(sub_id, subscription);
    }

    /// Unsubscribe a specific subscription.
    pub fn unsubscribe(&self, subscription_id: &str) {
        if let Some((_, sub)) = self.subscriptions.remove(subscription_id) {
            let key = (sub.collection, sub.filter_hash);
            if let Some(mut set) = self.dependency_map.get_mut(&key) {
                set.remove(subscription_id);
                if set.is_empty() {
                    drop(set);
                    self.dependency_map.remove(&key);
                }
            }
        }
    }

    /// Remove all subscriptions for a connection (on disconnect).
    pub fn disconnect(&self, connection_id: &str) {
        if let Some((_, sub_ids)) = self.connections.remove(connection_id) {
            for sub_id in sub_ids {
                self.unsubscribe(&sub_id);
            }
        }
    }

    /// Find all subscriptions affected by a change to a collection.
    pub fn find_affected(&self, collection: &str, filter_hash: u64) -> Vec<Subscription> {
        let key = (collection.to_string(), filter_hash);
        if let Some(sub_ids) = self.dependency_map.get(&key) {
            sub_ids
                .iter()
                .filter_map(|id| self.subscriptions.get(id).map(|s| s.clone()))
                .collect()
        } else {
            vec![]
        }
    }

    /// Find ALL subscriptions for a collection (regardless of filter).
    /// Used when we can't determine the specific filter hash of a change.
    pub fn find_all_for_collection(&self, collection: &str) -> Vec<Subscription> {
        self.subscriptions
            .iter()
            .filter(|entry| entry.value().collection == collection)
            .map(|entry| entry.value().clone())
            .collect()
    }

    /// Find subscriptions watching a specific document.
    pub fn find_document_subscribers(
        &self,
        collection: &str,
        document_id: &str,
    ) -> Vec<Subscription> {
        self.subscriptions
            .iter()
            .filter(|entry| {
                let sub = entry.value();
                sub.collection == collection && sub.document_id.as_deref() == Some(document_id)
            })
            .map(|entry| entry.value().clone())
            .collect()
    }

    /// Find all affected subscriptions for a change event.
    /// Checks collection-level subs (by filter hash) AND document-level subs.
    pub fn find_all_affected(
        &self,
        collection: &str,
        document_id: &str,
        filter_hash: u64,
    ) -> Vec<Subscription> {
        let mut result = self.find_affected(collection, filter_hash);
        let doc_subs = self.find_document_subscribers(collection, document_id);

        // Deduplicate by subscription ID
        let existing_ids: std::collections::HashSet<_> =
            result.iter().map(|s| s.id.clone()).collect();
        for sub in doc_subs {
            if !existing_ids.contains(&sub.id) {
                result.push(sub);
            }
        }

        result
    }

    // ── Presence ──

    /// Mark a user as online.
    pub fn set_presence(&self, user_id: &str, connection_id: &str, metadata: serde_json::Value) {
        self.presence.insert(
            user_id.to_string(),
            PresenceInfo {
                user_id: user_id.to_string(),
                connection_id: connection_id.to_string(),
                status: "online".to_string(),
                last_seen: chrono::Utc::now().to_rfc3339(),
                metadata,
            },
        );
    }

    /// Mark a user as offline (remove from presence).
    pub fn remove_presence(&self, connection_id: &str) {
        self.presence
            .retain(|_, info| info.connection_id != connection_id);
    }

    /// Update last_seen timestamp for a connection (heartbeat).
    pub fn heartbeat(&self, connection_id: &str) {
        for mut entry in self.presence.iter_mut() {
            if entry.value().connection_id == connection_id {
                entry.value_mut().last_seen = chrono::Utc::now().to_rfc3339();
            }
        }
    }

    /// Get all online users.
    pub fn get_online_users(&self) -> Vec<PresenceInfo> {
        self.presence.iter().map(|e| e.value().clone()).collect()
    }

    /// Check if a specific user is online.
    pub fn is_online(&self, user_id: &str) -> bool {
        self.presence.contains_key(user_id)
    }

    /// Get presence info for a specific user.
    pub fn get_presence(&self, user_id: &str) -> Option<PresenceInfo> {
        self.presence.get(user_id).map(|e| e.clone())
    }

    /// Get total online user count.
    pub fn online_count(&self) -> usize {
        self.presence.len()
    }

    /// Get total active subscription count.
    pub fn subscription_count(&self) -> usize {
        self.subscriptions.len()
    }

    /// Get total active connection count.
    pub fn connection_count(&self) -> usize {
        self.connections.len()
    }
}

impl Default for SubscriptionRegistry {
    fn default() -> Self {
        Self {
            subscriptions: DashMap::new(),
            dependency_map: DashMap::new(),
            connections: DashMap::new(),
            presence: DashMap::new(),
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn make_sub(
        id: &str,
        collection: &str,
        filter_hash: u64,
    ) -> (Subscription, mpsc::Receiver<RealtimeMessage>) {
        let (tx, rx) = mpsc::channel(16);
        let sub = Subscription {
            id: id.to_string(),
            collection: collection.to_string(),
            filter_hash,
            document_id: None,
            user_id: None,
            sender: tx,
        };
        (sub, rx)
    }

    #[test]
    fn test_subscribe_and_find() {
        let registry = SubscriptionRegistry::new();
        let (sub, _rx) = make_sub("sub1", "products", 123);

        registry.subscribe("conn1", sub);

        assert_eq!(registry.subscription_count(), 1);
        assert_eq!(registry.connection_count(), 1);

        let affected = registry.find_affected("products", 123);
        assert_eq!(affected.len(), 1);
        assert_eq!(affected[0].id, "sub1");
    }

    #[test]
    fn test_unsubscribe() {
        let registry = SubscriptionRegistry::new();
        let (sub, _rx) = make_sub("sub1", "products", 123);
        registry.subscribe("conn1", sub);

        registry.unsubscribe("sub1");
        assert_eq!(registry.subscription_count(), 0);
        assert_eq!(registry.find_affected("products", 123).len(), 0);
    }

    #[test]
    fn test_disconnect_cleans_all() {
        let registry = SubscriptionRegistry::new();
        let (sub1, _rx1) = make_sub("sub1", "products", 123);
        let (sub2, _rx2) = make_sub("sub2", "orders", 456);
        registry.subscribe("conn1", sub1);
        registry.subscribe("conn1", sub2);

        assert_eq!(registry.subscription_count(), 2);

        registry.disconnect("conn1");
        assert_eq!(registry.subscription_count(), 0);
        assert_eq!(registry.connection_count(), 0);
    }

    #[test]
    fn test_find_all_for_collection() {
        let registry = SubscriptionRegistry::new();
        let (sub1, _rx1) = make_sub("sub1", "products", 100);
        let (sub2, _rx2) = make_sub("sub2", "products", 200);
        let (sub3, _rx3) = make_sub("sub3", "orders", 300);
        registry.subscribe("conn1", sub1);
        registry.subscribe("conn2", sub2);
        registry.subscribe("conn3", sub3);

        let product_subs = registry.find_all_for_collection("products");
        assert_eq!(product_subs.len(), 2);
    }

    #[test]
    fn test_multiple_connections() {
        let registry = SubscriptionRegistry::new();
        let (sub1, _rx1) = make_sub("sub1", "products", 123);
        let (sub2, _rx2) = make_sub("sub2", "products", 123);
        registry.subscribe("conn1", sub1);
        registry.subscribe("conn2", sub2);

        assert_eq!(registry.connection_count(), 2);

        // Both should be found for same filter
        let affected = registry.find_affected("products", 123);
        assert_eq!(affected.len(), 2);

        // Disconnect one
        registry.disconnect("conn1");
        assert_eq!(registry.subscription_count(), 1);
        assert_eq!(registry.find_affected("products", 123).len(), 1);
    }

    // ── Document-level subscription tests ─────────────────────────

    fn make_doc_sub(
        id: &str,
        collection: &str,
        document_id: &str,
    ) -> (Subscription, mpsc::Receiver<RealtimeMessage>) {
        let (tx, rx) = mpsc::channel(16);
        let sub = Subscription {
            id: id.to_string(),
            collection: collection.to_string(),
            filter_hash: 0,
            document_id: Some(document_id.to_string()),
            user_id: None,
            sender: tx,
        };
        (sub, rx)
    }

    #[test]
    fn test_document_level_subscribe() {
        let registry = SubscriptionRegistry::new();
        let (sub, _rx) = make_doc_sub("sub1", "users", "user_42");
        registry.subscribe("conn1", sub);

        let subs = registry.find_document_subscribers("users", "user_42");
        assert_eq!(subs.len(), 1);
        assert_eq!(subs[0].id, "sub1");

        // Different doc should not match
        let subs = registry.find_document_subscribers("users", "user_99");
        assert_eq!(subs.len(), 0);
    }

    #[test]
    fn test_find_all_affected_combines_collection_and_doc() {
        let registry = SubscriptionRegistry::new();

        // Collection-level sub
        let (col_sub, _rx1) = make_sub("col_sub", "orders", 0);
        registry.subscribe("conn1", col_sub);

        // Document-level sub
        let (doc_sub, _rx2) = make_doc_sub("doc_sub", "orders", "order_123");
        registry.subscribe("conn2", doc_sub);

        let affected = registry.find_all_affected("orders", "order_123", 0);
        assert_eq!(affected.len(), 2);
    }

    // ── Presence tests ─────────────────────────────────────────────

    #[test]
    fn test_presence_set_and_get() {
        let registry = SubscriptionRegistry::new();
        registry.set_presence("user1", "conn1", serde_json::json!({"device": "mobile"}));

        assert!(registry.is_online("user1"));
        assert!(!registry.is_online("user2"));
        assert_eq!(registry.online_count(), 1);

        let info = registry.get_presence("user1").unwrap();
        assert_eq!(info.user_id, "user1");
        assert_eq!(info.connection_id, "conn1");
        assert_eq!(info.status, "online");
        assert_eq!(info.metadata["device"], "mobile");
    }

    #[test]
    fn test_presence_remove_on_disconnect() {
        let registry = SubscriptionRegistry::new();
        registry.set_presence("user1", "conn1", serde_json::json!({}));
        registry.set_presence("user2", "conn2", serde_json::json!({}));

        assert_eq!(registry.online_count(), 2);

        registry.remove_presence("conn1");
        assert_eq!(registry.online_count(), 1);
        assert!(!registry.is_online("user1"));
        assert!(registry.is_online("user2"));
    }

    #[test]
    fn test_presence_get_online_users() {
        let registry = SubscriptionRegistry::new();
        registry.set_presence("alice", "conn1", serde_json::json!({}));
        registry.set_presence("bob", "conn2", serde_json::json!({}));

        let online = registry.get_online_users();
        assert_eq!(online.len(), 2);

        let ids: Vec<&str> = online.iter().map(|p| p.user_id.as_str()).collect();
        assert!(ids.contains(&"alice"));
        assert!(ids.contains(&"bob"));
    }

    #[test]
    fn test_presence_heartbeat_updates_last_seen() {
        let registry = SubscriptionRegistry::new();
        registry.set_presence("user1", "conn1", serde_json::json!({}));

        let before = registry.get_presence("user1").unwrap().last_seen.clone();
        std::thread::sleep(std::time::Duration::from_millis(10));
        registry.heartbeat("conn1");
        let after = registry.get_presence("user1").unwrap().last_seen;

        // Timestamps should differ (or at least not crash)
        assert!(!before.is_empty());
        assert!(!after.is_empty());
    }

    #[test]
    fn test_presence_overwrite_same_user() {
        let registry = SubscriptionRegistry::new();
        registry.set_presence("user1", "conn1", serde_json::json!({"v": 1}));
        registry.set_presence("user1", "conn2", serde_json::json!({"v": 2}));

        // Should be overwritten (latest connection wins)
        assert_eq!(registry.online_count(), 1);
        let info = registry.get_presence("user1").unwrap();
        assert_eq!(info.connection_id, "conn2");
        assert_eq!(info.metadata["v"], 2);
    }

    #[test]
    fn test_find_all_affected_no_duplicates() {
        let registry = SubscriptionRegistry::new();

        // Same sub is both collection-level (filter_hash 0) and has a doc_id
        // This shouldn't happen in practice but tests dedup
        let (sub, _rx) = make_sub("sub1", "products", 0);
        registry.subscribe("conn1", sub);

        let affected = registry.find_all_affected("products", "prod_1", 0);
        // sub1 matches via collection filter but NOT via doc_id (it's None)
        assert_eq!(affected.len(), 1);
    }
}
