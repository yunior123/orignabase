{
	email admin@orignagta.ca
}

(api_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https:; font-src 'self' data:; connect-src 'self' https://api.stripe.com; frame-ancestors 'none'"
		-Server
	}
}

(site_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdn.docuseal.com 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'self' https://js.stripe.com https://signatures.orignagta.ca https://signatures.dev.orignagta.ca https://signatures.staging.orignagta.ca https://challenges.cloudflare.com; frame-ancestors 'self'"
		-Server
	}
}

(signatures_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "frame-ancestors 'self' https://orignagta.ca https://www.orignagta.ca https://dev.orignagta.ca https://staging.orignagta.ca"
		-Server
	}
}

(cors) {
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "{args[0]}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, Origin, Accept, X-Requested-With"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	header {
		Access-Control-Allow-Origin "{args[0]}"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, Origin, Accept, X-Requested-With"
		Access-Control-Allow-Credentials "true"
		Vary "Origin"
	}
}

# Production API — api.orignagta.ca (TLS auto via Let's Encrypt)
api.orignagta.ca {
	import api_security_headers
	encode zstd gzip
	reverse_proxy orignabase:8080
}

# Staging API — api-staging.orignagta.ca
api-staging.orignagta.ca {
	import api_security_headers
	encode zstd gzip
	reverse_proxy orignabase:8080
}

signatures.orignagta.ca, signatures.dev.orignagta.ca, signatures.staging.orignagta.ca {
	import signatures_security_headers
	encode zstd gzip
	reverse_proxy docuseal:3000
}

# Production website
orignagta.ca, www.orignagta.ca {
	import site_security_headers
	encode zstd gzip
	root * /var/www/orignagta
	try_files {path} {path}/ /index.html
	file_server
}

mail.orignagta.ca, mail.orignaventures.ca {
	reverse_proxy 172.18.0.1:5000 {
		header_up Host mail.orignagta.ca
		header_up X-Forwarded-Host mail.orignagta.ca
	}
	encode zstd gzip
	log {
		output file /var/log/postal-caddy.log
	}
}

# Dev fallback — direct IP access (HTTP only, no TLS)
:80 {
	import api_security_headers
	encode zstd gzip
	reverse_proxy orignabase:8080
}
